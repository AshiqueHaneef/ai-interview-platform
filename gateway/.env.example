# Gateway config for local (non-Docker) dev — copy to .env
# Prisma CLI and the app both read DATABASE_URL from here.
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/interview
AI_SERVICE_URL=http://localhost:8000
# Origin allowed to send the credential cookie (the web app).
WEB_ORIGIN=http://localhost:3000
# Signs the credential cookie. Generate per environment: openssl rand -hex 32
AUTH_SECRET=local-dev-only-not-a-real-secret
